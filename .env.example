# Superuser — migrations, seed, login-by-email
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/collections

# Request path — RLS-enforced role created by migrations
APP_DATABASE_URL=postgresql+psycopg://app_user:app_user_dev_password@localhost:5434/collections
APP_USER_PASSWORD=app_user_dev_password

JWT_SECRET=dev-secret-change-me

# Required only for POST /ask (the agent). Balance, priority, and the eval harness do not need it.
GEMINI_API_KEY=

MAX_TOOL_CALLS=10
MAX_SECONDS=20
PROVIDER_MODE=ok
